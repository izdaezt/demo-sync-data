{
  "framework": "vite",
  "buildCommand": "vite build && tsc -p tsconfig.server.json",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": ".env"
    }
  }
}
